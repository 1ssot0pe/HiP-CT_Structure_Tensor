# Python environments and caches
.venv/
.venv-*/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Editor and assistant settings (personal, not project)
.vscode/
.idea/
.claude/

# Input data -- download separately (see README, "Data")
data/
*.tif
*.tiff
lung_A.npy
lung_B.npy

# Pipeline outputs. Only the small JSON summaries are tracked; the bulky
# outputs (HTML viewers, .trk tractograms, .npz fields, NIfTI, logs) are
# regenerated by the scripts and archived with each GitHub release.
results/**
!results/**/
!results/**/*.json
*.nii
*.nii.gz
pipeline_results.json
pipeline_i74_results.json
stage3_validation.json
unified_field_*.npz

# Figures are regenerated by the scripts; the few used in docs are kept
*.png
!docs/figures/*.png

# Report drafts -- the Markdown source is tracked, exports are not
*.docx
~$*
